{
  "name": "gtnh-server-updater",
  "version": "0.1.0",
  "description": "Prepare GTNH server upgrades over SSH",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "smoke:ui": "electron scripts/visual-smoke.cjs",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run src/main/e2e --reporter=verbose",
    "smoke:ipc": "electron scripts/ipc-smoke.cjs",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "release:win": "electron-vite build && electron-builder --win --publish always",
    "release:linux": "electron-vite build && electron-builder --linux --publish always",
    "dist:docker": "node scripts/docker-dist.mjs",
    "release:docker": "node scripts/docker-dist.mjs --publish",
    "smoke:fixture": "electron scripts/fixture-smoke.cjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.7",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.9",
    "monaco-editor": "^0.56.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ssh2": "^1.17.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "41.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.32.1",
  "author": {
    "name": "Elyspio",
    "email": "jona.guich69@gmail.com"
  },
  "homepage": "https://github.com/Elyspio/gtnh-server-updater"
}

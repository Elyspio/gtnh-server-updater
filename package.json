{
	"name": "gtnh-server-updater",
	"version": "0.1.0",
	"description": "Prepare GTNH server upgrades over SSH",
	"homepage": "https://github.com/Elyspio/gtnh-server-updater",
	"author": {
		"name": "Elyspio",
		"email": "jona.guich69@gmail.com"
	},
	"main": "./out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"preview": "electron-vite preview",
		"check": "vp check",
		"lint": "vp lint",
		"fmt": "vp fmt",
		"test": "vp test",
		"smoke:ui": "electron scripts/visual-smoke.cjs",
		"test:e2e": "vp test run src/main/e2e --reporter=verbose",
		"smoke:ipc": "electron scripts/ipc-smoke.cjs",
		"smoke:fixture": "electron scripts/fixture-smoke.cjs",
		"dist:win": "electron-vite build && electron-builder --win --publish never",
		"dist:linux": "electron-vite build && electron-builder --linux --publish never",
		"release:win": "electron-vite build && electron-builder --win --publish always",
		"release:linux": "electron-vite build && electron-builder --linux --publish always",
		"dist:docker": "node scripts/docker-dist.mjs",
		"release:docker": "node scripts/docker-dist.mjs --publish"
	},
	"dependencies": {
		"@electron-toolkit/preload": "^3.0.2",
		"@electron-toolkit/utils": "^4.0.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@mui/icons-material": "^9.4.0",
		"@mui/material": "^9.4.0",
		"diff": "^9.0.0",
		"electron-updater": "^6.8.9",
		"monaco-editor": "^0.56.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"ssh2": "^1.17.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@electron-toolkit/tsconfig": "^2.0.0",
		"@elyspio/vite-eslint-config": "^8.0.0-rc.0",
		"@types/node": "^26.6.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/ssh2": "^1.15.6",
		"@vitejs/plugin-react": "^6.1.1",
		"electron": "44.4.3",
		"electron-builder": "^26.15.3",
		"electron-vite": "^5.0.0",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": ">=26.0.0"
	},
	"packageManager": "pnpm@12.5.1"
}

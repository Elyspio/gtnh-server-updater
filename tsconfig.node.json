{
	"extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
	"include": ["electron.vite.config.ts", "vite.config.ts", "src/main/**/*.ts", "src/preload/**/*.ts", "src/shared/**/*.ts"],
	"compilerOptions": {
		"composite": true,
		"noEmit": true,
		"strict": true,
		"types": ["node", "electron-vite/node"],
		"paths": { "@shared/*": ["./src/shared/*"] }
	}
}
